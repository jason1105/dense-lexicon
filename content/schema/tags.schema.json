{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dense-lexicon/schema/tags.schema.json",
  "title": "Dense Lexicon tag vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dimensions"],
  "properties": {
    "version": { "const": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "tags"],
        "properties": {
          "key": { "enum": ["discipline", "engineering", "cognitive", "scenario", "level"] },
          "name": { "type": "string", "minLength": 2, "maxLength": 8 },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "name", "description"],
              "properties": {
                "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
                "name": { "type": "string", "minLength": 2, "maxLength": 16 },
                "description": { "type": "string", "minLength": 2, "maxLength": 60, "pattern": "^[^\\n]+$" }
              }
            }
          }
        }
      }
    }
  }
}
