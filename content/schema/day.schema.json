{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dense-lexicon.vercel.app/schema/day.schema.json",
  "title": "Dense Lexicon Day",
  "description": "每日三词：单日内容文件 content/days/YYYY-MM-DD.json（v2：多维标签 + 完整介绍）",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "words"],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "format": "date",
      "description": "Asia/Shanghai 日期，必须与文件名一致"
    },
    "words": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/word" }
    }
  },
  "$defs": {
    "term": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 .+/'()-]*$"
    },
    "tagList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 16 }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "termZh"],
      "properties": {
        "term": { "$ref": "#/$defs/term" },
        "termZh": { "type": "string", "minLength": 2, "maxLength": 40 },
        "note": { "type": "string", "minLength": 2, "maxLength": 60, "description": "一句话说明二者关系" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 2, "maxLength": 120 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 300 }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "term", "termZh", "domain", "hook", "definition", "tags",
        "background", "problem", "actors", "evolution",
        "compresses", "scene", "misconception", "relations", "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "term 的 kebab-case，全库唯一"
        },
        "term": { "$ref": "#/$defs/term" },
        "termZh": { "type": "string", "minLength": 2, "maxLength": 40 },
        "domain": {
          "type": "string",
          "description": "主领域（导航用的一级分类），细分见 tags.engineering",
          "enum": [
            "architecture",
            "distributed-systems",
            "data",
            "testing",
            "devops",
            "observability",
            "security",
            "ai-engineering",
            "frontend",
            "process"
          ]
        },
        "hook": { "type": "string", "minLength": 6, "maxLength": 40, "description": "一句话记忆钩子" },
        "definition": { "type": "string", "minLength": 20, "maxLength": 200 },
        "tags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discipline", "engineering", "cognitive", "scenario", "level"],
          "description": "五个维度的标签，取值必须在 content/tags.json 对应维度的词表里",
          "properties": {
            "discipline": { "$ref": "#/$defs/tagList", "description": "学科" },
            "engineering": { "$ref": "#/$defs/tagList", "description": "工程" },
            "cognitive": { "$ref": "#/$defs/tagList", "description": "认知" },
            "scenario": { "$ref": "#/$defs/tagList", "description": "场景" },
            "level": { "$ref": "#/$defs/tagList", "type": "array", "maxItems": 2, "description": "层级" }
          }
        },
        "background": { "type": "string", "minLength": 20, "maxLength": 240, "description": "背景：在什么年代、什么环境下出现" },
        "problem": { "type": "string", "minLength": 20, "maxLength": 200, "description": "为了解决什么问题" },
        "actors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "description": "关键参与方（国家/机构/公司/人物），每项形如“名称：作用”",
          "items": { "type": "string", "minLength": 4, "maxLength": 80 }
        },
        "evolution": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "description": "演化过程，按时间先后，每项以时间开头，形如“1968：…”",
          "items": { "type": "string", "minLength": 6, "maxLength": 100 }
        },
        "compresses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 40 }
        },
        "scene": { "type": "string", "minLength": 20, "maxLength": 200 },
        "misconception": { "type": "string", "minLength": 20, "maxLength": 200 },
        "relations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["related", "opposite"],
          "properties": {
            "related": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/relation" } },
            "opposite": { "type": "array", "minItems": 0, "maxItems": 3, "items": { "$ref": "#/$defs/relation" } }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/source" }
        }
      }
    }
  }
}
